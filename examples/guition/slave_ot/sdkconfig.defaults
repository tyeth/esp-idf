# slave_ot: ESP-Hosted coprocessor + OpenThread RCP
# Base defaults (applies to all targets)

# --- ESP-Hosted Coprocessor ---
# Use the esp-hosted slave code but with our own app_main
CONFIG_ESP_HOSTED_COPROCESSOR_APP_MAIN=n
# Disable BT sharing — we're using OT, not WiFi/BT
CONFIG_ESP_HOSTED_COPROCESSOR_BT_ENABLED=n
# SDIO transport to P4 host
CONFIG_ESP_SDIO_HOST_INTERFACE=y

# --- WiFi: disabled (OT-only mode) ---
# We still need the esp_wifi component for the SDIO slave to compile,
# but we won't actually use WiFi.

# --- Flash Size ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Partition Table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- Compiler ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# --- Log ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
